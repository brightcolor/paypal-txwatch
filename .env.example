APP_NAME="PayPal TxWatch"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Docker Compose service name is "db"; use 127.0.0.1 for a non-Docker setup.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=paypal_txwatch
DB_USERNAME=paypal_txwatch
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="reports@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- PayPal TxWatch ---------------------------------------------------
# How many hours before "now" a scheduled sync re-checks, to catch
# PayPal transactions that can appear up to ~3h delayed.
PAYPAL_SYNC_LOOKBACK_HOURS=4
# Floor for the Dashboard "Sync-Gesundheit" warning; scales up with an
# account's own sync_interval_minutes if that's larger (see PaypalAccount::isSyncOverdue()).
PAYPAL_SYNC_WARNING_THRESHOLD_HOURS=2
PAYPAL_SYNC_MAX_PAGE_SIZE=500
PAYPAL_SYNC_MAX_RECORDS_PER_WINDOW=10000

# Remind (once per session) admins without 2FA to enable it. This only nags -
# it never blocks access. Set to false to silence the reminder entirely.
TWO_FACTOR_NAG_ADMINS=true

# Only used if the distro chromium/node/npm paths differ from the image defaults.
# CHROMIUM_PATH=/usr/bin/chromium
# NODE_MODULE_PATH=/opt/node/node_modules
# NODE_BINARY=/usr/bin/node
# NPM_BINARY=/usr/bin/npm

# docker-compose.yml: host port the "web" (nginx) service is published on.
APP_PORT=8090

# --- Bankzugang -------------------------------------------------------
#
# FinTS/HBCI IS OFF BY DEFAULT. Without a product registration activated by the
# Deutsche Kreditwirtschaft the bank server rejects every dialog with
# "9078 - Banking-Programm ist nicht registriert" - and it does so AFTER a
# successful login, which makes it look like a TxWatch defect. Set this to 1 once
# your registration number actually works; nothing is deleted meanwhile, stored
# credentials come back with it.
# FINTS_ENABLED=1

# Enable Banking (PSD2) - the path that needs no DK registration.
#
# NORMALLY LEAVE BOTH UNSET: an admin uploads the key from the control panel
# under "Bank -> Bank verbinden", and it is stored (mode 0600) under
# storage/app/private/enablebanking - which the deployment already bind-mounts,
# so it survives a container rebuild.
#
# Set them only to pin the credentials from the outside. THEY THEN WIN over
# anything uploaded through the UI (the page says so), because an entry here is
# the operator's explicit statement and must not be overridden by a click.
# ENABLEBANKING_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# ENABLEBANKING_KEY_PATH=/var/www/html/storage/app/private/enablebanking/key.pem
#
# There is no reason to change the API host; it exists for test doubles.
# ENABLEBANKING_BASE_URL=https://api.enablebanking.com
#
# REMEMBER THE RETURN ADDRESS. In the Enable Banking control panel this exact
# URL has to be registered, or the consent breaks off before the customer even
# reaches their bank:
#     https://<your APP_URL>/bank/enablebanking/callback
# The self test on the setup page checks precisely this and prints the address.
